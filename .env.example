# Copy to .env and set a strong password.
STRESSLAB_PASSWORD=CHANGE_ME
# Comma-separated exact hostnames, no wildcards.
ALLOWED_HOSTS=example.com,www.example.com

MAX_REQUESTS=500
MAX_CONCURRENCY=5
MIN_INTERVAL_MS=500
MAX_K6_VUS=5
MAX_K6_DURATION=30
MAX_K6_RATE=5

DATABASE_PATH=data/stresslab.sqlite3
K6_BIN=/usr/bin/k6
